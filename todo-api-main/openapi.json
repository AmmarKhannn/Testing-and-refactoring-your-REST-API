{
  "openapi": "3.0.3",
  "info": {
    "title": "Todo API",
    "version": "1.0.0",
    "description": "A simple API for creating, viewing, updating and deleting todos."
  },
  "servers": [{ "url": "http://localhost:3000", "description": "Local server" }],
  "tags": [{ "name": "Todos", "description": "Operations on todo items" }],
  "components": {
    "schemas": {
      "Todo": {
        "type": "object",
        "required": ["id", "title", "description", "state", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "readOnly": true },
          "title": { "type": "string", "example": "Study HTTP basics" },
          "description": { "type": "string", "example": "Read notes" },
          "state": { "type": "string", "enum": ["todo", "doing", "done"] },
          "dueDate": { "type": "string", "format": "date", "example": "2027-01-15" },
          "createdAt": { "type": "string", "format": "date-time", "readOnly": true },
          "updatedAt": { "type": "string", "format": "date-time", "readOnly": true }
        }
      },
      "CreateTodo": {
        "type": "object",
        "required": ["title"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "example": "Study HTTP basics" },
          "description": { "type": "string", "example": "Read notes" },
          "state": { "type": "string", "enum": ["todo", "doing", "done"], "default": "todo" },
          "dueDate": { "type": "string", "format": "date", "example": "2027-01-15" }
        }
      },
      "UpdateTodo": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "example": "Study more HTTP" },
          "description": { "type": "string" },
          "state": { "type": "string", "enum": ["todo", "doing", "done"] },
          "dueDate": { "type": "string", "format": "date" }
        }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } },
        "required": ["error"]
      }
    },
    "parameters": {
      "TodoId": {
        "name": "id", "in": "path", "required": true,
        "description": "ID returned when the todo was created",
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid input",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "Todo not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  },
  "paths": {
    "/todos": {
      "get": {
        "tags": ["Todos"], "summary": "Get all todos",
        "description": "Filter by state if needed. Choose JSON or CSV using the Accept header. In Swagger UI, select the response format before using Try it out.",
        "parameters": [{
          "name": "state", "in": "query", "required": false,
          "description": "Only return todos with this state",
          "schema": { "type": "string", "enum": ["todo", "doing", "done"] }
        }],
        "responses": {
          "200": {
            "description": "Todos returned",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Todo" } }
              },
              "text/csv": {
                "schema": { "type": "string" },
                "example": "id,title,description,state,dueDate,createdAt,updatedAt\n123,\"Study HTTP basics\",\"Read notes\",done,,2026-11-20T10:00:00.000Z,2026-11-20T10:00:00.000Z"
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "406": { "description": "Requested response format is not supported" }
        }
      },
      "post": {
        "tags": ["Todos"], "summary": "Create a todo",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateTodo" } } } },
        "responses": {
          "201": {
            "description": "Todo created",
            "headers": { "Location": { "description": "URL of the created todo", "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Todo" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "413": { "description": "Request body is too large" },
          "415": { "description": "JSON Content-Type is required" }
        }
      }
    },
    "/todos/{id}": {
      "get": {
        "tags": ["Todos"], "summary": "Get one todo",
        "parameters": [{ "$ref": "#/components/parameters/TodoId" }],
        "responses": {
          "200": { "description": "Todo found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Todo" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Todos"], "summary": "Update a todo",
        "description": "Only the fields in the request will be changed.",
        "parameters": [{ "$ref": "#/components/parameters/TodoId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateTodo" } } } },
        "responses": {
          "200": { "description": "Updated todo", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Todo" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": { "description": "Request body is too large" },
          "415": { "description": "JSON Content-Type is required" }
        }
      },
      "delete": {
        "tags": ["Todos"], "summary": "Delete a todo",
        "parameters": [{ "$ref": "#/components/parameters/TodoId" }],
        "responses": {
          "204": { "description": "Todo deleted (no response body)" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  }
}
